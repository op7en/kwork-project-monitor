{
  "name": "kwork-project-monitor",
  "version": "0.1.0",
  "private": true,
  "description": "Personal Telegram bot and independent Gmail READ ONLY metadata check for Kwork emails.",
  "type": "module",
  "engines": {
    "node": "^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch --import tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests vitest.config.ts eslint.config.mjs",
    "gmail:check": "node --env-file-if-exists=.env --import tsx src/gmail/check.ts",
    "parser:check": "node --import tsx src/kwork/check.ts",
    "smoke:once": "node --env-file-if-exists=.env --import tsx src/smoke/run.ts"
  },
  "dependencies": {
    "googleapis": "^183.0.0",
    "grammy": "^1.46.0",
    "node-html-parser": "^9.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "eslint": "^10.12.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
