TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_OWNER_ID=123456789
GMAIL_CLIENT_ID=your_google_client_id
GMAIL_CLIENT_SECRET=your_google_client_secret
GMAIL_REFRESH_TOKEN=your_google_refresh_token
GMAIL_EXPECTED_ACCOUNT_EMAIL=your_email@example.com

# One-shot smoke only (Milestone 4.3): ID of the single pre-selected Gmail message. Local environment only.
SMOKE_GMAIL_MESSAGE_ID=your_gmail_message_id_here

# Monitoring remains OFF until a fresh private-owner /monitor on after every restart.
# Interval 5..1440 minutes; default is 6 hours. No automatic activation from environment.
MONITOR_INTERVAL_MINUTES=360
# Application-level production limits per pass (not a whole-run acceptance guarantee).
MONITOR_MAX_MESSAGES=100
MONITOR_MAX_SENDS=10

# Separate manually authorized M5 acceptance only; one selected NEW message after baseline.
MONITOR_ACCEPTANCE_MESSAGE_ID=your_selected_message_id_here
